# SQLite database used by Prisma (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# --- LLM provider -----------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty (or set LLM_PROVIDER=mock) to run the app fully
# offline with the deterministic mock analyst. Set a real key to run the agents
# against the Claude API.
ANTHROPIC_API_KEY=""

# "anthropic" | "mock". Defaults to "anthropic" when a key is present,
# otherwise "mock".
LLM_PROVIDER=""

# Claude model used by all agents.
ANTHROPIC_MODEL="claude-opus-4-8"

# --- Web research -----------------------------------------------------------
# "mock" (default) or "anthropic-web-search" (uses Claude's server-side web
# search tool during the Buyer Research agent; requires an API key).
WEB_RESEARCH_PROVIDER="mock"

# Directory where uploaded pitch decks are stored.
UPLOAD_DIR="./uploads"
